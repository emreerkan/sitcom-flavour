---
import Command from './Command.astro';
import Terminal from './Terminal.astro';
import { shows, totalLines } from '../lib/banks';

const words = ['HOT', 'DAMN!'];
---

<section class="hero" id="top">
  <div class="stage-light" aria-hidden="true"></div>
  <div class="wrap">
    <div class="topline">
      <p class="eyebrow">A Claude Code plugin</p>
      <button class="lamp" type="button" data-applause aria-label="Applause sign. Plays applause with sound.">
        <span class="lamp-text">Applause</span>
      </button>
    </div>

    <h1 class="title" aria-label="Hot damn!">
      {words.map((word, w) => (
        <span class="word" aria-hidden="true">
          {[...word].map((ch, i) => (
            <span class:list={['ch', { bang: ch === '!' }]} style={`--i:${w * 4 + i}`}>{ch}</span>
          ))}
        </span>
      ))}
    </h1>

    <div class="credit">
      <p class="cue">
        <button type="button" class="who" data-memorial-open aria-label="Remembering Andre Braugher">Capt. Raymond Holt</button>
        <span class="paren">(and now, occasionally, Claude)</span>
      </p>
    </div>

    <div class="intro">
      <p class="lead">
        Sitcom lines for your Claude Code sessions. Matched to the moment, used sparingly,
        and never anywhere near your code.
      </p>
      <div class="cta">
        <Command cmd="/plugin marketplace add emreerkan/sitcom-flavour" size="lg" />
        <p class="meta">
          {shows.length} shows · {totalLines} hand-picked lines · bash only, no network
          <a href="#install">Full install →</a>
        </p>
      </div>
    </div>

    <Terminal />
  </div>
</section>

<style>
  .hero { position: relative; padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(3rem, 8vw, 6rem); isolation: isolate; }

  .stage-light {
    position: absolute; inset: -4rem 0 auto; height: 44rem; z-index: -1; pointer-events: none;
    background:
      radial-gradient(40rem 22rem at 18% 18%, color-mix(in oklch, var(--gold) 26%, transparent), transparent 70%),
      radial-gradient(34rem 20rem at 86% 8%, color-mix(in oklch, var(--red) 16%, transparent), transparent 70%);
    opacity: 0.8;
  }

  .topline { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }

  /* The studio sign. Lit by the demo or by a click. */
  .lamp {
    --lit: 0;
    position: relative;
    padding: 0.55rem 1.1rem;
    border-radius: 10px;
    border: 2px solid color-mix(in oklch, var(--red) calc(40% + var(--lit) * 60%), var(--rule));
    background: color-mix(in oklch, var(--red) calc(var(--lit) * 100%), var(--paper-2));
    color: color-mix(in oklch, white calc(var(--lit) * 100%), var(--red-ink));
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 85%;
    font-size: 0.95rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow:
      inset 0 0 0 3px color-mix(in oklch, var(--paper) calc(100% - var(--lit) * 100%), transparent),
      0 0 calc(var(--lit) * 42px) color-mix(in oklch, var(--red) 70%, transparent);
    transition: --lit 0.35s, background 0.35s, box-shadow 0.35s, color 0.35s, border-color 0.35s;
  }
  .lamp:hover { --lit: 0.25; }
  .lamp[data-lit] { --lit: 1; animation: buzz 0.18s steps(2) 2; }
  .lamp-text { position: relative; }

  @keyframes buzz { 50% { opacity: 0.55; } }

  .title {
    display: flex; flex-wrap: wrap; column-gap: 0.18em; row-gap: 0;
    margin-top: clamp(1.25rem, 3vw, 2rem);
    font-size: clamp(5.4rem, 21vw, 21.5rem);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.8;
    letter-spacing: -0.005em;
    font-variation-settings: 'opsz' 96;
  }
  .word { display: inline-flex; white-space: nowrap; }
  .ch {
    display: inline-block;
    animation: drop 0.9s var(--ease-spring) both;
    animation-delay: calc(0.15s + var(--i) * 0.055s);
    text-shadow: 0.03em 0.03em 0 var(--gold);
  }
  .bang {
    color: var(--red);
    text-shadow: 0.035em 0.035em 0 var(--gold);
    transform-origin: 50% 90%;
    animation: drop 0.9s var(--ease-spring) both, wobble 3.2s 1.4s ease-in-out infinite;
    animation-delay: calc(0.15s + var(--i) * 0.055s), 1.6s;
    filter: drop-shadow(var(--glow));
  }

  @keyframes drop {
    from { transform: translateY(-0.5em) rotate(-8deg); opacity: 0; }
    to { transform: none; opacity: 1; }
  }
  @keyframes wobble {
    0%, 80%, 100% { transform: rotate(0); }
    85% { transform: rotate(9deg); }
    90% { transform: rotate(-6deg); }
    95% { transform: rotate(3deg); }
  }

  /* Screenplay-style character cue. */
  /* The title's letter boxes overhang this line, so lift it to keep the
     credit clickable. */
  .credit { position: relative; z-index: 1; margin-top: clamp(1.25rem, 3vw, 2rem); font-family: var(--font-script); }
  .cue { width: fit-content; }
  .cue { display: grid; gap: 0.1rem; justify-items: start; padding-left: clamp(0rem, 12vw, 11rem); }
  /* Looks and behaves like the surrounding text: the dialog is an easter egg. */
  .who {
    padding: 0; border: 0; background: none;
    font: inherit; color: inherit;
    text-transform: uppercase; letter-spacing: 0.06em; font-weight: 700; font-size: 1.05rem;
    cursor: inherit;
  }
  .paren { color: var(--ink-3); }

  .intro {
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(1.5rem, 5vw, 4rem);
    align-items: end; margin-block: clamp(2.5rem, 6vw, 4rem);
  }
  .lead { font-size: clamp(1.25rem, 2.4vw, 1.75rem); line-height: 1.35; font-weight: 450; max-width: 30ch; }
  .cta { display: grid; gap: 0.75rem; min-width: 0; }
  .meta { font-size: 0.9rem; color: var(--ink-3); display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; justify-content: space-between; }
  .meta a { font-weight: 650; color: var(--ink); text-decoration: none; }
  .meta a:hover { color: var(--red-ink); }

  @media (max-width: 860px) {
    .intro { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .title { font-size: 31vw; flex-direction: column; }
    .cue { padding-left: 0; }
  }
</style>

<script>
  import { applause } from '../scripts/audio';

  // Registered so the lamp's --lit can transition.
  try {
    CSS.registerProperty({ name: '--lit', syntax: '<number>', inherits: true, initialValue: '0' });
  } catch {}

  const lamp = document.querySelector<HTMLButtonElement>('[data-applause]');
  let timer: number | undefined;

  function light(ms = 1800) {
    if (!lamp) return;
    lamp.removeAttribute('data-lit');
    void lamp.offsetWidth;
    lamp.dataset.lit = '';
    clearTimeout(timer);
    timer = window.setTimeout(() => lamp.removeAttribute('data-lit'), ms);
  }

  lamp?.addEventListener('click', () => {
    light(2600);
    applause();
  });

  // The terminal demo fires this whenever a line lands.
  document.addEventListener('sf:line', () => light());
</script>
