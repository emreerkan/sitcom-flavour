---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="header">
  <div class="wrap bar">
    <a class="brand" href="#top" aria-label="sitcom-flavour, back to top">
      <Logo />
      <span>sitcom<span class="dash">-</span>flavour</span>
    </a>
    <nav aria-label="Sections">
      <a href="#situations">Situations</a>
      <a href="#frequency">Frequency</a>
      <a href="#cast">Cast</a>
      <a href="#install" class="nav-cta">Install</a>
    </nav>
    <div class="tools">
      <a class="gh" href="https://github.com/emreerkan/sitcom-flavour" aria-label="GitHub repository">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(14px) saturate(1.4);
    background: color-mix(in oklch, var(--paper) 78%, transparent);
    border-bottom: 1px solid color-mix(in oklch, var(--rule) 70%, transparent);
  }
  .bar { display: flex; align-items: center; gap: 1.5rem; height: 4rem; }
  .brand {
    display: inline-flex; align-items: center; gap: 0.6rem;
    font-weight: 750; font-size: 1.05rem; letter-spacing: -0.01em; text-decoration: none;
  }
  .brand:hover { color: inherit; }
  .dash { color: var(--red); }
  nav { display: flex; gap: 1.4rem; margin-left: auto; font-size: 0.95rem; }
  nav a { text-decoration: none; color: var(--ink-2); }
  nav a:hover { color: var(--ink); }
  .nav-cta {
    color: var(--ink) !important; font-weight: 650;
    border-bottom: 2px solid var(--red);
  }
  .tools { display: flex; align-items: center; gap: 0.4rem; }
  .gh {
    display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 999px;
    color: var(--ink-2);
  }
  .gh:hover { color: var(--ink); background: var(--paper-2); }

  @media (max-width: 720px) {
    nav a:not(.nav-cta) { display: none; }
    .bar { gap: 0.75rem; }
  }
  @media (max-width: 420px) {
    .brand > span { display: none; }
  }
</style>
