---
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="closing">
      <p class="fin">Fin.</p>
      <button type="button" class="rimshot" data-rimshot aria-label="Play a rimshot (sound)">
        <svg viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="8" rx="8" ry="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M4 8v7c0 1.7 3.6 3 8 3s8-1.3 8-3V8" fill="none" stroke="currentColor" stroke-width="2"/><path d="m15 2 5 3.5M9 2 4 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        Ba-dum tss
      </button>
    </div>

    <div class="bottom">
      <a class="brand" href="#top"><Logo size={22} /> sitcom-flavour</a>
      <p>
        MIT licensed. Made by <a href="https://github.com/emreerkan">Emre Erkan</a> and{" "}
        <a href="https://claude.ai/">Claude</a>. Source on{" "}
        <a href="https://github.com/emreerkan/sitcom-flavour">GitHub</a>.
      </p>
      <p class="keys">
        <button type="button" data-help-open>Press <kbd>h</kbd> for keyboard shortcuts</button>
      </p>
      <p class="legal">
        Quotes are short excerpts used for commentary and belong to their rights holders. Not affiliated with any
        network, studio or show, or with Anthropic. © {year}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer { padding-block: clamp(3rem, 8vw, 6rem) 2.5rem; border-top: 1px solid var(--rule); }
  .closing { display: flex; align-items: end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .fin {
    font-family: var(--font-script); font-style: italic;
    font-size: clamp(3.5rem, 12vw, 8rem); line-height: 0.9; color: var(--ink);
  }
  .rimshot {
    display: inline-flex; align-items: center; gap: 0.55rem;
    padding: 0.8rem 1.2rem;
    border-radius: 999px; border: 2px solid var(--ink);
    background: transparent; color: var(--ink);
    font-weight: 750; cursor: pointer;
    transition: background 0.2s, color 0.2s, transform 0.25s var(--ease-spring);
  }
  .rimshot svg { width: 1.25rem; height: 1.25rem; }
  .rimshot:hover { background: var(--ink); color: var(--paper); }
  .rimshot:active { transform: scale(0.94); }
  .rimshot[data-hit] svg { animation: hit 0.5s var(--ease-spring); }
  @keyframes hit { 30% { transform: rotate(-14deg) scale(1.15); } 60% { transform: rotate(8deg); } }

  .bottom {
    display: grid; grid-template-columns: auto 1fr; gap: 0.5rem 2rem; align-items: baseline;
    margin-top: clamp(2.5rem, 6vw, 4rem); padding-top: 1.5rem; border-top: 1px solid var(--rule);
    font-size: 0.9rem; color: var(--ink-2);
  }
  .brand { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 750; color: var(--ink); text-decoration: none; }
  .keys { grid-column: 2; }
  .keys button {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0; border: 0; background: none;
    color: var(--ink-2); font-size: 0.85rem; cursor: pointer;
  }
  .keys button:hover { color: var(--ink); }
  .keys kbd {
    display: inline-grid; place-items: center;
    min-width: 1.4rem; height: 1.4rem; padding: 0 0.3rem;
    border: 1px solid var(--rule); border-bottom-width: 2px; border-radius: 6px;
    background: var(--paper-2); color: var(--ink);
    font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700;
  }
  .legal { grid-column: 2; font-size: 0.8rem; color: var(--ink-3); }
  @media (max-width: 640px) {
    .bottom { grid-template-columns: 1fr; }
    .legal, .keys { grid-column: auto; }
  }
</style>

<script>
  import { rimshot } from '../scripts/audio';

  const btn = document.querySelector<HTMLButtonElement>('[data-rimshot]');
  btn?.addEventListener('click', () => {
    rimshot();
    btn.removeAttribute('data-hit');
    void btn.offsetWidth;
    btn.dataset.hit = '';
  });
</script>
