---
import { shows } from '../lib/banks';
import CopyButton from './CopyButton.astro';

// One accent hue per show, used sparingly.
const hues: Record<string, number> = {
  'silicon-valley': 195,
  b99: 85,
  'the-office': 250,
  'parks-and-rec': 150,
  community: 45,
  'arrested-development': 105,
  seinfeld: 300,
  himym: 25,
  friends: 275,
  'it-crowd': 340,
  'good-place': 170,
};

const words = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];
const count = words[shows.length] ?? String(shows.length);

// Pre-selected to match the example most people will copy first.
const DEFAULT = ['silicon-valley', 'b99', 'community'];
const MAX = 3;
const initial = `/flavour ${shows.filter((s) => DEFAULT.includes(s.slug)).map((s) => s.slug).join(',')}`;

const cast = shows.map((show) => {
  const lines = show.situations.flatMap((s) => s.lines.map((line) => ({ line, heading: s.heading })));
  const pick = lines.find((l) => l.line.kind === 'quote' && l.line.text.length > 12) ?? lines[0];
  return { show, pick, hue: hues[show.slug] ?? 30 };
});
---

<section class="section cast" id="cast">
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">The cast</p>
      <h2>{count} shows. Pick up to three.</h2>
      <p>Select up to three shows below and get your command. Silicon Valley is the default, or bring your own.</p>
    </header>

    <div class="picker" data-cast data-max={MAX}>
      <div class="cmd-bar">
        <code><span class="prompt" aria-hidden="true">›</span><span data-cmd>{initial}</span></code>
        <span class="counter" aria-live="polite"><span data-count>{DEFAULT.length}</span>/{MAX}</span>
        <CopyButton value={initial} data-cmd-copy="" />
      </div>
      <p class="hint" data-hint aria-live="polite"></p>

      <ul class="grid" role="list" aria-label="Shows">
        {cast.map(({ show, pick, hue }) => (
          <li class="card pickable" style={`--h:${hue}`}>
            <input
              class="toggle"
              type="checkbox"
              value={show.slug}
              checked={DEFAULT.includes(show.slug)}
              aria-label={`${show.name} (${show.slug})`}
            />
            <div class="card-top">
            <code class="slug">{show.slug}</code>
            {show.slug === 'silicon-valley' && <span class="badge">Default</span>}
          </div>
          <h3>{show.name}</h3>
          {pick && (
            <blockquote>
              <p>{pick.line.kind === 'quote' ? `“${pick.line.text}”` : pick.line.text}</p>
              {pick.line.who && <cite>{pick.line.who}</cite>}
            </blockquote>
          )}
            <p class="stats">
              {show.lineCount} lines · {show.situations.length} situations
            </p>
            <span class="check" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </li>
        ))}

        <li class="card yours">
        <div class="yours-text">
          <div class="card-top"><code class="slug">personal</code></div>
          <h3>Your show</h3>
          <p class="yours-copy">
            Add lines in <code>~/.claude/sitcom-flavour/banks/</code>. They never ship, so the spicy ones stay yours.
          </p>
        </div>
        <pre><code><span class="c">## The Wire</span>
- "All the pieces matter."</code></pre>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .cast { background: var(--paper-2); border-block: 1px solid var(--rule); }
  .section-head code { white-space: nowrap; font-size: 0.85em; background: var(--card); border: 1px solid var(--rule); padding: 0.1rem 0.4rem; border-radius: 6px; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr)); gap: 1rem; }

  .card {
    --accent: oklch(0.72 0.14 var(--h, 30));
    position: relative;
    display: flex; flex-direction: column; gap: 0.9rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--rule);
    overflow: hidden;
    transition: transform 0.3s var(--ease-spring), box-shadow 0.3s;
  }
  .card::before {
    content: ''; position: absolute; inset: 0 0 auto; height: 5px; background: var(--accent);
  }
  /* Selectable cards: a full-size invisible checkbox keeps native keyboard,
     focus and screen reader behaviour without nesting headings in a label. */
  .pickable { cursor: pointer; transition: transform 0.3s var(--ease-spring), box-shadow 0.3s, border-color 0.2s, opacity 0.2s; }
  .toggle { position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
  .pickable:hover { transform: translateY(-4px) scale(1.025); box-shadow: var(--shadow); }
  .pickable:active { transform: scale(0.985); }
  .pickable:has(.toggle:focus-visible) { outline: 3px solid var(--gold); outline-offset: 3px; }
  .pickable:has(.toggle:checked) {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent), var(--shadow);
  }
  .picker[data-full] .pickable:not(:has(.toggle:checked)) { opacity: 0.55; }
  .picker[data-full] .pickable:not(:has(.toggle:checked)):hover { opacity: 0.8; }
  .pickable[data-nope] { animation: nope 0.4s; }
  @keyframes nope {
    20%, 60% { translate: -6px 0; }
    40%, 80% { translate: 6px 0; }
  }

  .check {
    position: absolute; right: 1rem; bottom: 1rem;
    display: grid; place-items: center;
    width: 1.9rem; height: 1.9rem; border-radius: 50%;
    background: var(--accent); color: oklch(0.2 0.012 60);
    opacity: 0; transform: scale(0.3) rotate(-30deg);
    transition: opacity 0.2s, transform 0.35s var(--ease-spring);
  }
  .check svg { width: 1.05rem; height: 1.05rem; }
  .pickable:has(.toggle:checked) .check { opacity: 1; transform: none; }

  .yours:hover { transform: translateY(-3px) rotate(-0.4deg); box-shadow: var(--shadow); }

  .cmd-bar {
    display: flex; align-items: center; gap: 0.75rem;
    max-width: 40rem;
    background: var(--term); color: var(--term-ink);
    border-radius: 12px;
    padding: 0.35rem 0.35rem 0.35rem 1rem;
    box-shadow: var(--shadow);
  }
  .cmd-bar code { flex: 1; min-width: 0; font-size: 0.95rem; overflow-x: auto; white-space: nowrap; scrollbar-width: none; padding-block: 0.5rem; }
  .cmd-bar .prompt { color: var(--gold); margin-right: 0.6rem; font-weight: 700; }
  .cmd-bar [data-cmd][data-empty] { color: var(--term-dim); font-style: italic; }
  .counter { font-family: var(--font-mono); font-size: 0.8rem; color: var(--term-dim); font-variant-numeric: tabular-nums; }
  .counter span { color: var(--gold); font-weight: 700; }
  .hint { min-height: 1.4rem; margin: 0.5rem 0 1.25rem; font-size: 0.88rem; color: var(--red-ink); }

  .card-top { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .slug { font-size: 0.78rem; color: var(--ink-3); overflow-wrap: anywhere; }
  .badge {
    font-size: 0.7rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 0.2rem 0.55rem; border-radius: 999px;
    background: var(--red); color: white;
  }
  h3 { font-size: 1.6rem; font-weight: 800; font-stretch: 82%; }

  blockquote { font-family: var(--font-script); font-size: 1.02rem; line-height: 1.45; flex: 1; }
  cite { display: block; margin-top: 0.3rem; font-style: normal; font-weight: 700; text-transform: uppercase; font-size: 0.85rem; color: var(--ink-2); }
  cite::before { content: '— '; }
  .stats { font-size: 0.82rem; color: var(--ink-3); font-variant-numeric: tabular-nums; border-top: 1px dashed var(--rule); padding-top: 0.8rem; }

  .yours {
    background: transparent; border: 2px dashed var(--ink-3);
  }
  .yours-text { display: grid; gap: 0.9rem; }
  .yours::before { background: repeating-linear-gradient(90deg, var(--red) 0 14px, transparent 14px 22px); }
  .yours-copy { color: var(--ink-2); font-size: 0.95rem; }
  .yours-copy code { font-size: 0.8em; overflow-wrap: anywhere; }
  .yours pre {
    background: var(--term); color: var(--term-ink);
    border-radius: 10px; padding: 0.9rem 1rem; font-size: 0.78rem; white-space: pre-wrap; line-height: 1.6;
  }
  .yours .c { color: var(--term-dim); }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-cast]');
  if (root) {
    const max = Number(root.dataset.max ?? 3);
    const boxes = [...root.querySelectorAll<HTMLInputElement>('.toggle')];
    const cmd = root.querySelector<HTMLElement>('[data-cmd]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const copy = root.querySelector<HTMLButtonElement>('[data-cmd-copy]')!;
    const hint = root.querySelector<HTMLElement>('[data-hint]')!;
    let hintTimer: number | undefined;

    function render() {
      // Card order, not click order, so the command is stable.
      const picked = boxes.filter((b) => b.checked).map((b) => b.value);
      const value = picked.length ? `/flavour ${picked.join(',')}` : '';
      cmd.textContent = value || 'pick at least one show';
      cmd.toggleAttribute('data-empty', !value);
      count.textContent = String(picked.length);
      copy.disabled = !value;
      copy.dataset.copy = value;
      copy.setAttribute('aria-label', value ? `Copy: ${value}` : 'Copy command (pick a show first)');
      root!.toggleAttribute('data-full', picked.length >= max);
      // The "3 max" hint only makes sense while the selection is full.
      if (picked.length < max) {
        clearTimeout(hintTimer);
        hint.textContent = '';
      }
    }

    function nope(card: HTMLElement) {
      card.removeAttribute('data-nope');
      void card.offsetWidth;
      card.dataset.nope = '';
      hint.textContent = `Up to ${max} shows load at once. Deselect one first.`;
      clearTimeout(hintTimer);
      hintTimer = window.setTimeout(() => (hint.textContent = ''), 2800);
    }

    for (const box of boxes) {
      box.addEventListener('change', () => {
        if (box.checked && boxes.filter((b) => b.checked).length > max) {
          box.checked = false;
          nope(box.closest<HTMLElement>('.card')!);
          return;
        }
        render();
      });
    }
    render();
  }
</script>
