---
// A copy icon button. `tone` matches the surface it sits on.
interface Props {
  value: string;
  tone?: 'dark' | 'light';
  size?: 'sm' | 'md';
  class?: string;
  [key: `data-${string}`]: string;
}
const { value, tone = 'dark', size = 'md', class: className, ...rest } = Astro.props;
---

<button
  type="button"
  class:list={['copy', tone, size, className]}
  data-copy={value}
  aria-label={`Copy: ${value}`}
  {...rest}
>
  <svg viewBox="0 0 24 24" aria-hidden="true" class="ic-copy"><rect x="8" y="8" width="12" height="12" rx="2.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 8V6.5A2.5 2.5 0 0 0 13.5 4h-7A2.5 2.5 0 0 0 4 6.5v7A2.5 2.5 0 0 0 6.5 16H8" fill="none" stroke="currentColor" stroke-width="2"/></svg>
  <svg viewBox="0 0 24 24" aria-hidden="true" class="ic-done"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  <span class="copied" role="status" aria-live="polite"></span>
</button>

<style>
  .copy {
    position: relative;
    flex: none;
    display: grid; place-items: center;
    width: 2.4rem; height: 2.4rem;
    border-radius: 9px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s, opacity 0.2s;
  }
  .sm { width: 2.1rem; height: 2.1rem; border-radius: 8px; }
  .dark { border: 0; background: oklch(1 0 0 / 0.07); color: var(--term-dim); }
  .dark:hover { background: oklch(1 0 0 / 0.14); color: var(--term-ink); }
  .light { border: 1px solid var(--rule); background: var(--card); color: var(--ink-3); }
  .light:hover { color: var(--ink); border-color: var(--ink-3); }
  .copy:disabled { opacity: 0.35; cursor: not-allowed; }

  svg { width: 1.1rem; height: 1.1rem; grid-area: 1 / 1; transition: transform 0.25s var(--ease-spring), opacity 0.2s; }
  .sm svg { width: 1rem; height: 1rem; }
  .ic-done { opacity: 0; transform: scale(0.4); }
  .dark .ic-done { color: var(--term-green); }
  .light .ic-done { color: var(--red); }
  .copy[data-done] .ic-copy { opacity: 0; transform: scale(0.4); }
  .copy[data-done] .ic-done { opacity: 1; transform: none; }
  .copied { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>

<script>
  import '../scripts/copy';
</script>
