---
import { situations, shows, type SituationGroup } from '../lib/banks';

// Moments covered by several lines get their own tab; one-offs share the last one.
const featured = situations.filter((g) => g.entries.length > 1);
const oneOffs = situations.filter((g) => g.entries.length === 1);
const groups: (SituationGroup & { mixed?: boolean })[] = [
  ...featured,
  {
    id: 'rest-of-the-season',
    heading: 'The rest of the season',
    mixed: true,
    entries: oneOffs.flatMap((g) => g.entries.map((e) => ({ ...e, heading: g.heading }))),
  },
];
const first = groups[0]!;
---

<section class="section situations" id="situations">
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">How Claude picks a line</p>
      <h2>Situations, not catchphrases.</h2>
      <p>
        Every bank is sorted by the moment, not the character. Tests pass, a fix doesn't fix it, the cloud bill
        arrives. Claude matches the moment first, so you get the right line instead of the most famous one.
      </p>
    </header>

    <div class="explorer" data-explorer>
      <div class="picker" role="tablist" aria-label="Situations" aria-orientation="vertical">
        {groups.map((g, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${g.id}`}
            aria-controls="script"
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-situation={g.id}
          >
            <span class="label">{g.heading}</span>
            <span class="count" aria-label={`${g.entries.length} lines`}>{g.entries.length}</span>
          </button>
        ))}
      </div>

      <div class="script" id="script" role="tabpanel" aria-labelledby={`tab-${first.id}`} tabindex="0">
        <div class="page-head" aria-hidden="true">
          <span>SITCOM-FLAVOUR</span>
          <span data-page-no>1.</span>
        </div>
        {groups.map((g, i) => (
          <div class="scene" data-scene={g.id} hidden={i !== 0}>
            <p class="slug">INT. YOUR TERMINAL · {g.heading.toUpperCase()}</p>
            {g.entries.map(({ show, line, heading }) =>
              line.kind === 'quote' ? (
                <div class="beat">
                  {g.mixed && heading && <p class="moment">{heading}</p>}
                  <p class="cue">{(line.who ?? 'Ensemble').toUpperCase()}</p>
                  {line.direction && <p class="paren">({line.direction})</p>}
                  <p class="dialogue">{line.text}</p>
                  <p class="source">
                    {show.name}
                    {line.note && <span class="note"> · {line.note}</span>}
                  </p>
                </div>
              ) : (
                <div class="beat action">
                  {g.mixed && heading && <p class="moment">{heading}</p>}
                  <p class="dialogue">
                    {line.who && <span class="actor">{line.who.toUpperCase()}</span>} {line.text}.
                  </p>
                  <p class="source">
                    {show.name}
                    {line.note && <span class="note"> · {line.note}</span>}
                  </p>
                </div>
              ),
            )}
          </div>
        ))}
      </div>
    </div>

    <p class="footnote">
      {situations.length} situations across {shows.length} shows, read straight from the plugin's banks at build time.
      Italic lines are scene references Claude paraphrases rather than quotes.
    </p>
  </div>
</section>

<style>
  .situations { background: var(--paper-2); border-block: 1px solid var(--rule); }

  .explorer {
    display: grid;
    grid-template-columns: minmax(15rem, 22rem) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
  }

  .picker { display: grid; gap: 0.3rem; position: sticky; top: 5.5rem; max-height: calc(100dvh - 7rem); overflow-y: auto; padding: 0.25rem; }
  .picker button {
    display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
    text-align: left;
    padding: 0.7rem 0.9rem;
    border-radius: 10px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--ink-2);
    font-size: 0.98rem; font-weight: 550; line-height: 1.3;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s var(--ease-spring);
  }
  .picker button:hover { background: var(--card); color: var(--ink); }
  .picker button[aria-selected='true'] {
    background: var(--card); color: var(--ink); border-color: var(--rule);
    box-shadow: var(--shadow);
  }
  .picker button[aria-selected='true'] .count { background: var(--red); color: white; }
  .count {
    flex: none; min-width: 1.6rem; height: 1.6rem; padding: 0 0.4rem;
    display: grid; place-items: center; border-radius: 999px;
    background: var(--paper); font-size: 0.78rem; font-weight: 700; color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  /* A page from a shooting script. */
  .script {
    position: relative;
    background: var(--card);
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: clamp(1.5rem, 4vw, 3.25rem) clamp(1.25rem, 6vw, 4.5rem) clamp(2rem, 5vw, 3.5rem);
    font-family: var(--font-script);
    font-size: clamp(0.98rem, 1.4vw, 1.08rem);
    line-height: 1.45;
    box-shadow: var(--shadow), 6px 6px 0 -1px var(--paper), 6px 6px 0 0 var(--rule);
    min-height: 26rem;
  }
  .script::before {
    /* Three-hole punch. */
    content: ''; position: absolute; left: 0.9rem; top: 12%; bottom: 12%; width: 0.7rem;
    background: radial-gradient(circle, var(--paper-2) 0.3rem, var(--rule) 0.34rem, transparent 0.38rem) center / 0.7rem 33.3% repeat-y;
  }
  .page-head { display: flex; justify-content: space-between; color: var(--ink-3); font-size: 0.8em; margin-bottom: 1.75rem; }
  .slug { font-weight: 700; text-transform: uppercase; margin-bottom: 1.75rem; text-wrap: balance; }
  .scene { display: grid; gap: 1.6rem; }
  .scene[hidden] { display: none; }
  .slug { grid-column: 1 / -1; }
  @media (min-width: 1100px) {
    .scene { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2.5rem; }
  }
  .moment {
    font-family: var(--font-display); font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--red-ink);
    margin-bottom: 0.35rem;
  }
  .scene:not([hidden]) { animation: flip 0.45s var(--ease-out); }
  @keyframes flip { from { opacity: 0; transform: translateY(8px); } }

  .beat { display: grid; justify-items: center; text-align: center; gap: 0.1rem; }
  .cue { font-weight: 700; letter-spacing: 0.02em; }
  .paren { color: var(--ink-2); }
  .dialogue { max-width: 34ch; }
  .source {
    margin-top: 0.35rem;
    font-family: var(--font-display); font-size: 0.78rem; font-weight: 600;
    color: var(--ink-3); letter-spacing: 0.01em;
  }
  .note { font-weight: 450; }
  .action { justify-items: start; text-align: left; }
  .action .dialogue { max-width: none; font-style: italic; }
  .actor { font-style: normal; font-weight: 700; }

  .footnote { margin-top: 1.5rem; font-size: 0.88rem; color: var(--ink-3); max-width: 60ch; }

  @media (max-width: 820px) {
    .explorer { grid-template-columns: 1fr; }
    .picker {
      position: static; max-height: none;
      display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 0.4rem;
      margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .picker button { flex: none; scroll-snap-align: start; white-space: nowrap; border-color: var(--rule); }
    .script::before { display: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-explorer]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panel = root.querySelector<HTMLElement>('[role="tabpanel"]')!;
    const pageNo = root.querySelector<HTMLElement>('[data-page-no]');

    function select(tab: HTMLButtonElement, focus = false) {
      const id = tab.dataset.situation;
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      }
      for (const scene of panel.querySelectorAll<HTMLElement>('[data-scene]')) {
        scene.hidden = scene.dataset.scene !== id;
      }
      panel.setAttribute('aria-labelledby', tab.id);
      if (pageNo) pageNo.textContent = `${tabs.indexOf(tab) + 1}.`;
      if (focus) tab.focus();
      tab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    }

    for (const tab of tabs) tab.addEventListener('click', () => select(tab));

    root.querySelector('[role="tablist"]')?.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      const i = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
      const keys: Record<string, number> = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 };
      let target: number | undefined;
      if (ev.key in keys) target = (i + keys[ev.key]! + tabs.length) % tabs.length;
      else if (ev.key === 'Home') target = 0;
      else if (ev.key === 'End') target = tabs.length - 1;
      if (target === undefined) return;
      ev.preventDefault();
      select(tabs[target]!, true);
    });
  }
</script>
